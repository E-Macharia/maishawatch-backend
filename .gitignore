@"
# ============================
# Python
# ============================
__pycache__/
*.py[cod]
*.so
*.egg
*.egg-info/
dist/
build/
venv/
.venv/
env/
ENV/
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
*.pyi

# ============================
# Database
# ============================
*.db
*.sqlite
*.sqlite3
storage/
*.db-journal
*.db-wal
*.db-shm

# ============================
# Data Files (EXCLUDE ALL LARGE FILES)
# ============================
data/
!data/.gitkeep
*.csv
*.txt
*.xlsx
*.xls
!*.md

# ============================
# Models
# ============================
models/
!models/.gitkeep
*.pkl
*.joblib
*.h5
*.pb

# ============================
# Environment
# ============================
.env
.env.local
.env.*.local
!.env.example

# ============================
# IDE / OS
# ============================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.log
logs/

# ============================
# Generated Files
# ============================
generate_*.py
scripts/ingestion/
scripts/features/
reference/*.csv
!reference/.gitkeep

# ============================
# Misc
# ============================
*.bak
*.backup
*.tmp
*.temp
"@ | Out-File -FilePath .gitignore -Encoding utf8
